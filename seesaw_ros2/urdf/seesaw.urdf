<?xml version="1.0"?>
<robot name="seesaw">

  <link name="base_link"/>

  <link name="pitch_pivot_link"/>

  <joint name="base_to_pitch_pivot" type="fixed">
    <parent link="base_link"/>
    <child link="pitch_pivot_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0.016764 0 0.030734" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.070"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.9 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="pitch_joint" type="revolute">
    <parent link="pitch_pivot_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="1.0" velocity="5.0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.040 0.020 0.003"/>
      </geometry>
      <material name="green">
        <color rgba="0.2 0.8 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="lidar_to_imu" type="fixed">
    <parent link="lidar_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.054356 0 -0.021590" rpy="3.141592653589793 0 0"/>
  </joint>

</robot>
